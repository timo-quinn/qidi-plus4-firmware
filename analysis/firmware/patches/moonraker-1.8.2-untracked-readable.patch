+        out_dir_cfg = os.path.join(out_dir_cfg, '')
+        temp_dir_cfg = os.path.join(temp_dir_cfg, '')
+        # evaluate and expand "~"
+        self.out_dir = os.path.expanduser(out_dir_cfg)
+        self.temp_dir = os.path.expanduser(temp_dir_cfg)
