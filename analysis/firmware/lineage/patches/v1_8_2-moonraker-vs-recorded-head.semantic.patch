+    def get_json_list(
+        self,
+        key: str,
+        default: Union[Sentinel, _T] = Sentinel.MISSING,
+        item_type: Optional[Type] = None
+    ) -> Union[List[Any], _T]:
+        """
+        专门用于解析 JSON 请求中的数组。如果提供了 item_type，会尝试将每个元素转换为该类型。
+        """
+        if key not in self.args:
+            if default is Sentinel.MISSING:
+                raise ServerError(f"No data for argument: {key}")
+            return default
+            
+        value = self.args[key]
+        if not isinstance(value, list):
+            if isinstance(value, str) and value.startswith('['):
+                try:
+                    import json
+                    value = json.loads(value)
+                except:
+                    raise ServerError(f"Argument '{key}' is not a valid JSON list string")
+            else:
+                raise ServerError(f"Argument '{key}' expected List, got {type(value).__name__}")
+        if item_type is not None:
+            try:
+                return [item_type(val) for val in value]
+            except (ValueError, TypeError):
+                raise ServerError(
+                    f"Unable to convert all items in '{key}' to {item_type.__name__}"
+                )
+        
+        return value
+
 
