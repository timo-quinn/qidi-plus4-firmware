-        raise gcmd.error("Unable to parse parameter '%s'" % (name,))
-    if len(pair) != 2:
-        if len(pair) != 1:
-            raise gcmd.error("Unable to parse parameter '%s'" % (name,))
-        pair = (pair[0], pair[0])
-    if minval is not None:
-        if pair[0] < minval or pair[1] < minval:
-            raise gcmd.error("Parameter '%s' must have a minimum of %d"
