+    def _respond_error(self, msg):
+        logging.warning(msg)
+        lines = msg.strip().split('\n')
+        if len(lines) > 1:
+            self.respond_info("\n".join(lines), log=False)
+        self.respond_raw('!! %s' % (lines[0].strip(),))
