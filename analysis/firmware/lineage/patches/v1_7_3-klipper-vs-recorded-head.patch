+PROFILE_VERSION = 1
+PROFILE_OPTIONS = {
+    'min_x': float, 'max_x': float, 'min_y': float, 'max_y': float,
+    'x_count': int, 'y_count': int, 'mesh_x_pps': int, 'mesh_y_pps': int,
