+    # Response handling
+    def respond_raw(self, msg):
+        for cb in self.output_callbacks:
+            cb(msg)
+    def respond_info(self, msg, log=True):
+        if log:
+            logging.info(msg)
+        lines = [l.strip() for l in msg.strip().split('\n')]
