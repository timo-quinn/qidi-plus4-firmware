+    async def _publish_job_state_mqtt(
+        self,
+        job_event: str,
+        stats: Dict[str, Any],
+    ) -> None:
+        """发布任务状态变化到MQTT"""
+        try:
+            self.mqtt_client = self.server.lookup_component('mqtt')
+        except Exception:
+            self.mqtt_client = None
+
+        if self.mqtt_client is None or not self.mqtt_client.is_connected():
+            return
+        
+        try:
+            # 构建MQTT消息内容
+            mqtt_payload = {
+                "job_state": job_event,
+                "uid": stats.get("uid", "123456789"),
+                "timestamp": stats.get("print_duration", 0),
+                "filename": stats.get("filename", ""),
+                #"plateindex": stats.get("plateindex", "1"),
+                "user": getattr(self, 'job_user', 'No User')
+            }
+            
+            # 发布到MQTT主题
+            topic = f"{self.mqtt_client.instance_name}/job_state/changed"
+            await self.mqtt_client.publish_topic(topic, mqtt_payload)
+            
+            logging.debug(f"Published job state change to MQTT: {mqtt_payload}")
+            
+        except Exception as e:
