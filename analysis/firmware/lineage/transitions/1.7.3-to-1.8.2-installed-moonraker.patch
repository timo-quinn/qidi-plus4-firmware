+            'configured_type': str(self.type),
+            'channel': str(self.channel),
+            'info_tags': self.info_tags,
+            'last_error': self.last_error,
+            'is_valid': self._valid,
+            'warnings': self.warnings,
+            'anomalies': self.anomalies
+        }
