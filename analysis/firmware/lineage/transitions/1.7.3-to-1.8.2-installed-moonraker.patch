+def get_cpu_serial():
+    path = "/proc/device-tree/serial-number"
+    try:
+        with open(path, "rb") as f:
+            raw = f.read()
+            cleaned_bytes = raw.rstrip(b'\x00 \t\n\r')
+            serial = cleaned_bytes.decode('ascii').upper()   
+            return serial
+            
+    except Exception as e:
+        logging.error(f"读取 {path} 失败: {e}")
+    return "0000000000"
